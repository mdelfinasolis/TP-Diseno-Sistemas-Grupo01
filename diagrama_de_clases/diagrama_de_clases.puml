    + modificarFactor(datos: FactorEntradaDTO): void
    + darDeBajaFactor(codigo: String): void
    + obtenerFactor(codigo: String): Factor
    + validarDatos(datos: FactorEntradaDTO): boolean
    + validarCodigoUnico(codigo: String): boolean
    + validarNombreUnico(nombre: String, competencia: String): boolean
    + verificarEnUso(codigo: String): boolean
