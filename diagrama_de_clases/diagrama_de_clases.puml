    + modificarEmpresa(datos: EmpresaEntradaDTO): void
    + darDeBajaEmpresa(id: int): void
    + obtenerEmpresa(id: int): Empresa
    + listarEmpresas(): List~EmpresaListadoDTO~
    + validarDatos(datos: EmpresaEntradaDTO): boolean
    + validarNombreUnico(nombre: String): boolean
    + verificarEnUso(id: int): boolean
