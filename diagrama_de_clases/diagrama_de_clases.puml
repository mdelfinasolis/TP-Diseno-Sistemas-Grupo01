  }

  class GestorCuestionarios <<control>> {
    + obtenerCuestionario(datos: LoginCandidatoEntradaDTO): CuestionarioSalidaDTO
    + obtenerBloque(datos: ObtenerBloqueCuestionarioEntradaDTO): BloqueCuestionarioDTO
    + listarPreguntasBloque(datos: ObtenerBloqueCuestionarioEntradaDTO): List~PreguntaCuestionarioDTO~
    + listarOpcionesPregunta(codigoPregunta: String): List~OpcionCuestionarioDTO~
    + guardarBloque(datos: GuardarBloqueCuestionarioEntradaDTO): void
    + calcularResultados(claveCuestionario: String): void
    + finalizarCuestionario(datos: FinalizarCuestionarioEntradaDTO): ResultadoCuestionarioDTO
    + finalizarVencidos(): void
    + iniciarCuestionario(claveCuestionario: String): void
    + verificarVigencia(claveCuestionario: String): CuestionarioSalidaDTO
    - estaVencido(cuestionario: Cuestionario): boolean
    - superoMaximoAccesos(cuestionario: Cuestionario): boolean
    - seleccionarPreguntasAleatorias(preguntas: List~Pregunta~, cantidad: int): List~Pregunta~
    + buscarCuestionariosActivos(nrosCandidatos: List~int~): List~Cuestionario~
    + generarClave(): String
    + generarCuestionario(evaluacion: Evaluacion, candidato: Candidato, clave: String): Cuestionario
    + buscarPorEvaluacion(idEvaluacion: int): List~Cuestionario~
    + obtenerPorClave(clave: String): Cuestionario
  }

  class GestorReportes <<control>> {
    + buscarFunciones(filtros: FiltroFuncionEntradaDTO): List~FuncionBusquedaDTO~
    + listarCandidatosEvaluados(codigoPuesto: String): List~CandidatoEvaluadoDTO~
    + emitirReporteComparativo(datos: ReporteComparativoEntradaDTO): ReporteComparativoDTO
    + buscarPuestosOrdenMerito(filtros: FiltroFuncionEntradaDTO): List~PuestoOrdenMeritoDTO~
    + emitirOrdenMerito(datos: OrdenMeritoEntradaDTO): OrdenMeritoDTO
    + listarEvaluacionesPuesto(codigoPuesto: String): List~EvaluacionListadoDTO~
  }
}

package "Modelo de Dominio (Entity)" {
  abstract class Usuario <<entity>> {
    - id: int
    - nombre: String
    - apellido: String
  }

  class Consultor <<entity>> {
    - nombreUsuario: String
    + Consultor(nombreUsuario: String, nombre: String, apellido: String)
  }

  class Candidato <<entity>> {
    + coincideDocumento(tipo: TIPODOCUMENTO, nroDocumento: String): boolean
    + validarCredenciales(clave: String): boolean
    + getCuestionarios(): List~Cuestionario~
    - nroCandidato: int
    - tipoDocumento: TIPODOCUMENTO
    - nroDocumento: String
    - fechaNacimiento: Date
    - genero: GENERO
    - nacionalidad: String
    - email: String
    - escolaridad: String
    - eliminado: boolean
  }

  class Evaluacion <<entity>> {
    - id: int
    - fechaCreacion: Date
    - cantPreguntasPorBloque: int
    + Evaluacion(puesto: Puesto, fechaCreacion: Date, cantPreguntasPorBloque: int)
    + getPuesto(): Puesto
    + getCantPreguntasPorBloque(): int
    + getCantidadCandidatos(): int
    + getCuestionarios(): List~Cuestionario~
  }

  class PuestoCompetencia <<entity>> {
    - ponderacionMinima: integer {0, 10}
    + getCompetencia(): Competencia
    + getPuesto(): Puesto
  }

  class Competencia <<entity>> {
    - codigo: String
    - nombre: String
    - descripcion: String
    - tipo: String
    - eliminada: boolean
    + getFactores(): List~Factor~
  }

  class Puesto <<entity>> {
    - codigo: String
    - nombre: String
    - descripcion: String
    - eliminado: boolean
    + getCompetencias(): List~PuestoCompetencia~
    + getEmpresa(): Empresa
  }

  class Empresa <<entity>> {
    - id: int
    - nombre: String
  }

  class Factor <<entity>> {
    - codigo: String
    - nombre: String
    - descripcion: String
    - nroOrden: int
    - eliminado: boolean
    + getCompetencia(): Competencia
  }

  class Pregunta <<entity>> {
    - codigo: String
    - nombre: String
    - enunciado: String
    - descripcion: String
    - eliminada: boolean
    + Pregunta(nombre: String, enunciado: String, descripcion: String, factor: Factor, opcionRespuesta: OpcionRespuesta)
    + agregarPonderacion(ponderacion: PreguntaItemPonderacion): void
    + getFactor(): Factor
    + getOpcionRespuesta(): OpcionRespuesta
    + getPonderacion(item: ItemOpcion): double
    + getPonderaciones(): List~PreguntaItemPonderacion~
    + setCodigo(codigo: String): void
  }

  class OpcionRespuesta <<entity>> {
    - nombre: String
    - descripcion: String
    - eliminada: boolean
    + getItem(orden: int): ItemOpcion
    + getItems(): List~ItemOpcion~
  }

  class ItemOpcion <<entity>> {
    - orden: int
    - descripcion: String
    + getOpcionRespuesta(): OpcionRespuesta
  }

  class PreguntaItemPonderacion <<entity>> {
    - ponderacion: double
    + PreguntaItemPonderacion(pregunta: Pregunta, item: ItemOpcion, ponderacion: double)
    + getPregunta(): Pregunta
    + getItem(): ItemOpcion
  }

  class Cuestionario <<entity>> {
      - clave: String
      - tiempoMaximo: int
      + Cuestionario(evaluacion: Evaluacion, candidato: Candidato, clave: String, tiempoMaximo: int)
      + getDetalle(): DetalleCuestionario
      + getCandidato(): Candidato
      + getClave(): String
      + getEvaluacion(): Evaluacion
      + agregarPreguntaCuestionario(pc: PreguntaCuestionario): void
      + getPreguntasBloque(nroBloque: int): List~PreguntaCuestionario~
      + getPreguntaCuestionario(codigoPregunta: String): PreguntaCuestionario
      + getPreguntas(): List~PreguntaCuestionario~
      + agregarResultadoFactor(resultado: ResultadoFactor): void
      + agregarResultadoCompetencia(resultado: ResultadoCompetencia): void
      + getResultadosCompetencia(): List~ResultadoCompetencia~
      + getResultadosFactor(): List~ResultadoFactor~
  }

  class RespuestaSeleccionada <<entity>> {
      - fechaRespuesta: DateTime
      + RespuestaSeleccionada(item: ItemOpcion, fechaRespuesta: DateTime)
      + getItem(): ItemOpcion
  }

  class ResultadoFactor <<entity>> {
    - total: double
    + ResultadoFactor(factor: Factor, total: double)
    + getFactor(): Factor
  }

  class ResultadoCompetencia <<entity>> {
    - total: double
    + ResultadoCompetencia(competencia: Competencia, total: double)
    + getTotal(): double
    + getCompetencia(): Competencia
  }

  class RegistroAuditoria <<entity>> {
    - id: int
    - usuarioResponsable: String
    - fechaHora: DateTime
    - accion: ACCIONAUDITORIA
    - tipoEntidad: String
    - identificadorEntidad: String
  }

  class PreguntaCuestionario <<entity>> {
    - orden: int
    - nroBloque: int
    + PreguntaCuestionario(pregunta: Pregunta, orden: int, nroBloque: int)
    + getPregunta(): Pregunta
    + registrarRespuesta(item: ItemOpcion, fechaRespuesta: DateTime): void
    + getRespuesta(): RespuestaSeleccionada
  }

  enum GENERO {
    H
    M
  }

  enum TIPODOCUMENTO {
    DNI
    LE
    LC
    PP
  }

  enum ESTADOCUESTIONARIO {
    ACTIVO
    EN_PROCESO
    COMPLETO
    INCOMPLETO
    SIN_CONTESTAR
  }

  enum ACCIONAUDITORIA {
    ALTA
    MODIFICACIÓN
    BAJA
  }

  class DetalleCuestionario {
    - fechaInicio: DateTime
    - fechaFin: DateTime
    - estado: ESTADOCUESTIONARIO
    - cantidadAccesos: int
    - ultimoIngreso: DateTime
    + DetalleCuestionario(estado: ESTADOCUESTIONARIO)
    + getEstado(): ESTADOCUESTIONARIO
    + setEstado(estado: ESTADOCUESTIONARIO): void
    + registrarAcceso(fechaHora: DateTime): void
    + registrarInicio(fechaHora: DateTime): void
    + registrarFin(fechaHora: DateTime): void
  }
}

