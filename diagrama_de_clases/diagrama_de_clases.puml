    + validarPonderaciones(ponderaciones: List~PonderacionItemEntradaDTO~): List~String~
    + validarNombreUnico(nombre: String): boolean
    + validarOpcionRespuesta(nombreOpcionRespuesta: String): boolean
    + verificarEnUso(codigo: String): boolean
    + contarPreguntasPorFactor(codigosFactor: List~String~): Map~String, int~
