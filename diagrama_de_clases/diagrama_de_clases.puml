@startuml

skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageStyle rectangle
skinparam linetype ortho

' ===================================================
' Colores
' ===================================================

skinparam class {
  BackgroundColor<<boundary>>       #DEEAF1
  BorderColor<<boundary>>           #2E75B6
  HeaderBackgroundColor<<boundary>> #9DC3E6

  BackgroundColor<<control>>        #E2EFDA
  BorderColor<<control>>            #375623
  HeaderBackgroundColor<<control>>  #A9D18E

  BackgroundColor<<entity>>         #FCE4D6
  BorderColor<<entity>>             #843C0C
  HeaderBackgroundColor<<entity>>   #F4B183

  BackgroundColor<<DTO>>            #EADCF8
  BorderColor<<DTO>>                #7030A0
  HeaderBackgroundColor<<DTO>>      #C5A3E0

