  class GestorPuestos <<control>> {
    + buscarPuestos(filtros: FiltroPuestoEntradaDTO): List~PuestoListadoDTO~
    + listarCompetenciasRequeridas(codigoPuesto: String): List~CompetenciaRequeridaDTO~
    + crearPuesto(datos: PuestoEntradaDTO): void
    + modificarPuesto(datos: PuestoEntradaDTO): void
    + darDeBajaPuesto(codigo: String): boolean
    + obtenerPuesto(codigo: String): Puesto
    + listarPuestos(): List~PuestoListadoDTO~
    + verificarEnUso(codigo: String): boolean
    + validarDatos(datos: PuestoEntradaDTO): boolean
    + validarCodigoUnico(codigo: String): boolean
    + validarNombreUnico(nombre: String): boolean
  }

  class GestorCompetencias <<control>> {
    + buscarCompetencias(filtros: FiltroCompetenciaEntradaDTO): List~CompetenciaListadoDTO~
    + crearCompetencia(datos: CompetenciaEntradaDTO): void
    + modificarCompetencia(datos: CompetenciaEntradaDTO): void
    + darDeBajaCompetencia(codigo: String): void
    + obtenerCompetencia(codigo: String): Competencia
    + listarCompetencias(): List~CompetenciaListadoDTO~
    + validarDatos(datos: CompetenciaEntradaDTO): boolean
    + validarCodigoUnico(codigo: String): boolean
    + validarNombreUnico(nombre: String): boolean
    + verificarEnUso(codigo: String): boolean
