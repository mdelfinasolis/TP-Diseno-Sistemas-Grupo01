    + verificarCuestionariosActivos(nrosCandidatos: List~int~): List~CandidatoEvaluadoDTO~
    + generarClaves(nrosCandidatos: List~int~): List~CandidatoClaveDTO~
    + buscarPorPuesto(codigoPuesto: String): List~Evaluacion~
    - esEvaluable(factores: List~FactorListadoDTO~, cantidades: Map~String, int~): boolean
